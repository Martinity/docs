---
interface Props {
  href?: string;
  label?: string;
  symbols?: string[];
}

const { href, label, symbols } = Astro.props;
const Element = href ? 'a' : 'div';
---

<Element
  href={href}
  class="source-box"
  target={href ? "_blank" : undefined}
  rel={href ? "noopener noreferrer" : undefined}
>
  <span class="source-title">Source</span>

  <div class:list={["source-content", { "source-symbols": symbols }]}>
    {symbols ? (
      symbols.map((sym) => <code>{sym}</code>)
    ) : (
      label || <slot />
    )}
  </div>
</Element>

<style>
  .source-box {
    display: flex;
    align-items: flex-start; /* Changed from baseline to keep label at the top */
    gap: 0.75rem;
    margin: 1.5rem 0;
    padding: 0.75rem 1rem;
    background-color: var(--sl-color-bg-nav, rgba(0, 0, 0, 0.03));
    border: 1px solid var(--sl-color-hairline, rgba(0, 0, 0, 0.1));
    border-radius: 0.375rem;
    text-decoration: none;
    color: inherit;
    font-size: 0.875rem;
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }

  a.source-box:hover {
    background-color: var(--sl-color-gray-6, rgba(0, 0, 0, 0.05));
    border-color: var(--sl-color-gray-4, rgba(0, 0, 0, 0.2));
  }

  .source-title {
    font-weight: 700;
    text-transform: uppercase;
    font-size: 0.7rem;
    letter-spacing: 0.05em;
    color: var(--rs-blue, #60a5fa);
    flex-shrink: 0;
    margin-top: 0.15rem; /* Visually aligns with the first line of text/code */
  }

  .source-content {
    line-height: 1.5;
    overflow-wrap: break-word; /* Replaced break-all to prevent slicing words */
    font-family: var(--sl-font-mono, monospace);
  }

  /* Renders arrays of symbols as wrapping chips, eliminating comma awkwardness */
  .source-symbols {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.5rem;
    font-family: inherit;
  }

  /* Ensures individual code blocks never break internally */
  .source-content code {
    background-color: var(--sl-color-bg-inline-code, rgba(150, 150, 150, 0.15));
    padding: 0.15rem 0.35rem;
    border-radius: 0.25rem;
    font-family: var(--sl-font-mono, monospace);
    font-size: 0.85em;
    white-space: nowrap;
  }
</style>
